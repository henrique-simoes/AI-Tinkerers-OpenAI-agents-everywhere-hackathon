# Copy to .env and fill in. NEVER commit .env.
# Sponsor keys — take only the ones your build actually uses.

OPENAI_API_KEY=
OPENROUTER_API_KEY=
EXA_API_KEY=

# Ambiguous AI — key starts with ak_
AMBIGUOUS_API_KEY=

# CopilotKit (if using CopilotKit Cloud)
COPILOTKIT_API_KEY=

# Trigger.dev
TRIGGER_SECRET_KEY=

# Auth0
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Kimchi by Cast AI — OpenAI-compatible endpoint
KIMCHI_API_KEY=
KIMCHI_BASE_URL=https://llm.kimchi.dev/openai/v1
